PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=collection

# 阿里云号码认证（短信验证码）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 可选；须与控制台模板变量一致。默认由阿里云生成验证码并可核验
# ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}

# 登录态
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES=7d
REFRESH_EXPIRES_DAYS=30

# 开发阶段：写死验证码（默认开启；上线前设 SMS_DEV_MODE=false）
SMS_DEV_MODE=true
SMS_DEV_CODE=123456

# App Store 审核白名单（生产环境仍生效；该号不发真实短信，用固定验证码登录）
SMS_REVIEW_PHONE=15868843247
SMS_REVIEW_CODE=888888

# 百炼 DashScope（AI + Fun-ASR 转写）
DASHSCOPE_API_KEY=
# 可选，默认国内 compatible-mode；转写 API 会自动去掉 /compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_ROOT=https://dashscope.aliyuncs.com
ALIYUN_AI_MODEL=qwen3.8-max
# 自动打标 / 收藏页归类建议（与助手分开；调用量大，默认 flash）
ALIYUN_AI_MODEL_TAGS=qwen3.8-flash
# AI助手编排（规划/回答/深挖；与 TAGS 打标独立，改完需重启 backend）
ALIYUN_AI_MODEL_AGENT=qwen3.8-flash
# 图集整理文章看图（多模态）；无图时仍用 AGENT
ALIYUN_AI_MODEL_AGENT_VISION=qwen3-vl-plus
# 收藏知识库 embedding（助手语义召回；解析后异步写入 item_embeddings）
# ALIYUN_EMBEDDING_MODEL=text-embedding-v3
# ALIYUN_EMBEDDING_DIMS=1024
# AGENT_KB_ENABLED=true
# Fun-ASR 录音文件识别模型（非实时）
ALIYUN_ASR_MODEL=fun-asr

# 转写 · 说话人后处理（修正分轨误判，改完需重启 backend + force 重转）
# GAP_MS：句间停顿阈值，单位毫秒；800 表示停顿 ≤0.8 秒仍算同一人
ALIYUN_ASR_SPEAKER_GAP_MS=800
# ORPHAN_MAX_CHARS：极短误切短句（字）并入上一说话人，如「释放消费潜力。」
# ALIYUN_ASR_SPEAKER_ORPHAN_MAX_CHARS=15
# 转写时长硬上限（秒）；默认 3600=1 小时；设 0 关闭硬限（仍受可用转写分钟约束）
# ALIYUN_ASR_MAX_DURATION_SEC=3600
# 防盗链 CDN（B 站等）转写前上传 OSS；帮助页配图也写入该 Bucket 的 help/ 前缀。与短信共用 AccessKey
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_PREFIX=transcript-cache/
# ALIYUN_OSS_ENDPOINT=
# 转写下载体积上限（MB）；不配或 ≤0 = 不限制
# ALIYUN_OSS_TRANSCRIPT_MAX_MB=0
# 轻量测时长 Range 前缀（MB），默认 8；开放直链测到时长后可跳过全量下载
# ALIYUN_OSS_TRANSCRIPT_PROBE_MB=8
# ALIYUN_OSS_TRANSCRIPT_TIMEOUT_MS=900000
# ALIYUN_OSS_TRANSCRIPT_DOWNLOAD_TIMEOUT_MS=900000
# 抖音封面/图集落盘后，API 读出时签名有效期（秒，默认 7 天）
# ALIYUN_OSS_ITEM_MEDIA_URL_EXPIRES=604800

# 已废弃：NLS FileTrans（迁移至 Fun-ASR 后无需配置）
# ALIYUN_NLS_APP_KEY=

# 用量与订阅（触顶拦截默认开启；USAGE_ENFORCING=false 关闭额度与档位拦截，本地可不付费测 AI）
# USAGE_ENFORCING=true
FREE_ITEM_LIMIT=100
FREE_AI_TOKENS_PER_MONTH=0
FREE_TRANSCRIPT_MINUTES_PER_MONTH=0
PRINCE_AI_TOKENS_PER_MONTH=500000
PRINCE_TRANSCRIPT_MINUTES_PER_MONTH=200
EMPEROR_AI_TOKENS_PER_MONTH=800000
EMPEROR_TRANSCRIPT_MINUTES_PER_MONTH=400
# 月付免费试用额度（默认正式月额度 × 0.25；也可写绝对值覆盖）
# TRIAL_QUOTA_FRACTION=0.25
# TRIAL_PRINCE_AI_TOKENS_PER_MONTH=125000
# TRIAL_PRINCE_TRANSCRIPT_MINUTES_PER_MONTH=50
# TRIAL_EMPEROR_AI_TOKENS_PER_MONTH=200000
# TRIAL_EMPEROR_TRANSCRIPT_MINUTES_PER_MONTH=100

# Apple IAP（App Store Server API）
# App Store Connect → 用户和访问 → 密钥 → In-App Purchase 密钥 (.p8)
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# PEM 内容（换行写成 \n）或文件路径二选一
# APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_IAP_PRIVATE_KEY_PATH=/path/to/AuthKey_XXX.p8
APPLE_IAP_BUNDLE_ID=com.bufang.supercollection
# 普通会员（自动续期月付/年付；须在 ASC 订阅群组新建）
APPLE_IAP_PRODUCT_BASIC_MONTHLY=com.bufang.supercollection.basic.monthly
APPLE_IAP_PRODUCT_BASIC_YEARLY=com.bufang.supercollection.basic.yearly
# 旧版买断 SKU，仅识别已购
APPLE_IAP_PRODUCT_BASIC=com.bufang.supercollection.basic
# 太子（现有 monthly/yearly 可不改 Product ID，只改 ASC 文案）
APPLE_IAP_PRODUCT_MONTHLY=com.bufang.supercollection.monthly
APPLE_IAP_PRODUCT_YEARLY=com.bufang.supercollection.yearly
# 帝王（须在 ASC 新建）
APPLE_IAP_PRODUCT_EMPEROR_MONTHLY=com.bufang.supercollection.emperor.monthly
APPLE_IAP_PRODUCT_EMPEROR_YEARLY=com.bufang.supercollection.emperor.yearly
# auto | production | sandbox
APPLE_IAP_ENV=auto

# 微信支付 APP（Android）。未开通商户时保持 WECHAT_PAY_ENABLED=false，升级页仍显示「即将开放」
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
# PEM 内容（换行写成 \n）或文件路径二选一
# WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
# 公网 HTTPS，指向 POST /api/billing/wechat/notify
WECHAT_PAY_NOTIFY_URL=
# 价格（分）；须 >0 才可购。示例：9800=¥98
WECHAT_PAY_PRICE_BASIC_LIFETIME_FEN=
WECHAT_PAY_PRICE_PRINCE_MONTHLY_FEN=
WECHAT_PAY_PRICE_PRINCE_YEARLY_FEN=
WECHAT_PAY_PRICE_EMPEROR_MONTHLY_FEN=
WECHAT_PAY_PRICE_EMPEROR_YEARLY_FEN=

# 埋点看板、帮助文案、App 版本更新（/internal/analytics、/internal/help、/internal/app-update；请求头 X-Analytics-Token）。不设则这些后台返回 503
ANALYTICS_DASHBOARD_TOKEN=change-me-analytics
