PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=collection

# 阿里云号码认证（短信验证码）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 可选；须与控制台模板变量一致。默认由阿里云生成验证码并可核验
# ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}

# 登录态
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES=7d
REFRESH_EXPIRES_DAYS=30

# 开发阶段：写死验证码（默认开启；上线前设 SMS_DEV_MODE=false）
SMS_DEV_MODE=true
SMS_DEV_CODE=123456

# App Store 审核白名单（生产环境仍生效；该号不发真实短信，用固定验证码登录）
SMS_REVIEW_PHONE=15868843247
SMS_REVIEW_CODE=888888

# 阿里云智能语音 · 录音文件识别（NLS AppKey；与短信共用 AccessKey）
# 控制台：https://nls-portal.console.aliyun.com/applist
ALIYUN_NLS_APP_KEY=
# 可选，默认上海
# 转写 · 说话人后处理（修正 NLS 分轨误判，改完需重启 backend + force 重转）
# GAP_MS：句间停顿阈值，单位毫秒；800 表示停顿 ≤0.8 秒仍算同一人
ALIYUN_ASR_SPEAKER_GAP_MS=800
# ORPHAN_MAX_CHARS：极短误切短句（字）并入上一说话人，如「释放消费潜力。」
# ALIYUN_ASR_SPEAKER_ORPHAN_MAX_CHARS=15
# 转写时长上限（秒），默认 1200=20 分钟；超限不提交 NLS
# ALIYUN_ASR_MAX_DURATION_SEC=1200
# 与短信共用 AccessKey；Bucket 需与 NLS 同地域或可公网读签名 URL
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_PREFIX=transcript-cache/
# ALIYUN_OSS_ENDPOINT=
# ALIYUN_OSS_TRANSCRIPT_MAX_MB=512
# ALIYUN_OSS_TRANSCRIPT_TIMEOUT_MS=900000
# ALIYUN_OSS_TRANSCRIPT_DOWNLOAD_TIMEOUT_MS=900000
# 视频转写前抽 16kHz 单声道 mp3 再上传（默认 true；失败回退整文件）
# ALIYUN_OSS_TRANSCRIPT_EXTRACT_AUDIO=true
# 可选：覆盖 ffmpeg 路径（默认用依赖 ffmpeg-static）
# FFMPEG_PATH=/usr/local/bin/ffmpeg
