PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=collection

# 阿里云号码认证（短信验证码）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 可选；须与控制台模板变量一致。默认由阿里云生成验证码并可核验
# ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}

# 登录态
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES=7d
REFRESH_EXPIRES_DAYS=30

# 开发阶段：写死验证码（默认开启；上线前设 SMS_DEV_MODE=false）
SMS_DEV_MODE=true
SMS_DEV_CODE=123456

# App Store 审核白名单（生产环境仍生效；该号不发真实短信，用固定验证码登录）
SMS_REVIEW_PHONE=15868843247
SMS_REVIEW_CODE=888888

# 阿里云智能语音 · 录音文件识别（NLS AppKey；与短信共用 AccessKey）
# 控制台：https://nls-portal.console.aliyun.com/applist
ALIYUN_NLS_APP_KEY=
# 可选，默认上海
# ALIYUN_NLS_ENDPOINT=http://filetrans.cn-shanghai.aliyuncs.com
